@model IEnumerable<Ecommerce.Models.Category>

@{

    Layout = "~/Views/Shared/_Layoutadmin.cshtml";
}

<style>
    table {
        border-collapse: collapse;
        border-spacing: 0;
        width: 70%;
        border: 1px solid #ddd;
        margin-top: 55px;
    }

    th, td {
        text-align: left;
        padding: 10px;
    }

    tr:nth-child(even) {
        background-color: #f2f2f2;
    }
    a {
        font-size: 20px;
    }
</style>

<a href="~/Admin/Categories/Create/">
    <input type="button" value="Create" class="btn btn-outline-primary" @* style="position: absolute;margin-left: 25px;"*@>
</a>
    
    <table class="">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CategoryName)
            </th>
            <th>
                Image
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Active)
            </th>

            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                   @item.CategoryName
                </td>
                <td>
                    <img style="height:80px; width:85px;" src="@Url.Content(item.ImagePath)" />

                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Active)
                </td>

                <td>

                    @Html.ActionLink("Edit", "Edit", new { id = item.Id }, new { @style = "color:green;" }) |
                    @Html.ActionLink("Details", "Details", new { id = item.Id },new {@style="color:Grey" }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.Id },
                    new { onclick = "return confirm('Are sure wants to delete?');" })
                </td>
            </tr>
        }

    </table>

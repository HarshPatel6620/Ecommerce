    <!-- Search Wrapper Area Start -->
    <div class="search-wrapper section-padding-100">
        <div class="search-close">
            <i class="fa fa-close" aria-hidden="true"></i>
        </div>
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="search-content">
                        <form action="#" method="get">
                            <input type="search" name="search" id="search" placeholder="Type your keyword...">
                            <button type="submit"><img src="~/Adminstyle/img/core-img/search.png" alt=""></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Search Wrapper Area End -->
    <!-- ##### Main Content Wrapper Start ##### -->
    <div class="main-content-wrapper d-flex clearfix">

        <!-- Mobile Nav (max width 767px)-->
        <div class="mobile-nav">
            <!-- Navbar Brand -->
            <div class="amado-navbar-brand">
                <a href="index.html"><img src="~/Adminstyle/img/core-img/logo.png" alt=""></a>
            </div>
            <!-- Navbar Toggler -->
            <div class="amado-navbar-toggler">
                <span></span><span></span><span></span>
            </div>
        </div>

        <!-- Header Area Start -->
        <header class="header-area clearfix">
            <!-- Close Icon -->
            <div class="nav-close">
                <i class="fa fa-close" aria-hidden="true"></i>
            </div>
            <!-- Logo -->
            <div class="logo">
                <a href="index.html"><img src="~/Adminstyle/img/core-img/logo.png" alt=""></a>
                @if (User.Identity.IsAuthenticated)
                {
                    <p>  @User.Identity.Name</p>
                    <p>@Html.ActionLink("Logout", "Logout", "Users")</p>
                }
                else
                {
                    <p>  @User.Identity.Name</p>
                    <p>@Html.ActionLink("Login", "Login", "Users")</p>
                }

            </div>
            <!-- Amado Nav -->
            <nav class="amado-nav">
                <ul>

                    <li>@Html.ActionLink("Category", "Index", "Categories")</li>
                    <li><a href="@Url.Action("Index","Brands")">Brand</a></li>
                    <li>@Html.ActionLink("Product", "Index", "Products")</li>
                    <li>@Html.ActionLink("Color", "Index", "Colors")</li>

                </ul>
            </nav>
            <!-- Button Group -->
            @*<div class="amado-btn-group mt-30 mb-100">

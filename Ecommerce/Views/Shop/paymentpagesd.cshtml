@model Ecommerce.Models.Order
@{
    ViewBag.Title = "PaymentPage";
}




<button id="rzp-button1">Pay</button>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
    debugger;
        var options = {
            "Key":"@Html.DisplayFor(x => x.razorpaykey)",
            "amount":"@Html.DisplayFor(model=>model.OrderAmount)",
            "currency": "@Html.DisplayFor(model=>model.currency)",
            "name": "@Html.DisplayFor(model=>model.FirstName)",
            "description": "Buy Green Tea",
            "order_id": "@Html.DisplayFor(model=>model.orderId)",
            "image": "https://example.com/your_logo",
            "handler": function (response) {
                document.getElementById('rzp_paymentid').value = response.razorpay_payment_id;
                document.getElementById('rzp_orderid').value = response.razorpay_order_id;

                document.getElementById('rzp-paymentresponse').click();
            },


            "prefill": {
                "name": "@Html.DisplayFor(model=>model.FirstName)",
                "email": "@Html.DisplayFor(model=>model.Email)",
                "contact": "@Html.DisplayFor(model=>model.Mobile)"
            },
            "notes": {
                "address": "@Html.DisplayFor(model=>model.Address)"
            },
            "theme": {
                "color": "#3399cc"
            }
        };

        var rzp1 = new Razorpay(options);

        window.onload = function () {
            document.getElementById('rzp-button1').click();
    };
    $('#rzp-button1').click(function (e) {
        rzp1.open();
        e.preventDefault();

    })



</script>

@using (Html.BeginForm("Complete", "Shop"))
{
    @Html.AntiForgeryToken()

    @Html.Hidden("rzp_paymentid");
    @Html.Hidden("rzp_orderid");

    @* <input id="razorpay_signature" type="hidden" name="razorpay_signature" />*@
    <button type="submit" id="rzp-paymentresponse" class="btn btn-primary" hidden>subbb</button>
}





<script>
    slidMin = 0;
    slidMax = @ViewBag.d;
    

    $('.checkbox').change(function () {

        debugger;
        var str = "";
        var ct = $(".cl.active").attr("id");
      

        str = getSelectedCheckbox();
        console.log("str");
        str = str.replace(/,\s*$/, "");
        
        GetData(str, slidMin, slidMax, ct);
    });

    function getSelectedCheckbox(){
        var str = "";
        $('input[type=checkbox]').each(function () {
            if ($(this).prop("checked")) {
                str = str + $(this).attr("id") + ",";
            }
        });
        return str;
    }

    $(".slider-range").slider({
        
        range: true,
        min: 0,
        max: @ViewBag.d,
        values: [0, @ViewBag.d],
        slide: function (event, ui) {
            var minPrice = ui.values[0];
            var maxPrice = ui.values[1];
            slidMin = minPrice;
            slidMax = maxPrice;
            $(".Amount").html("Price: $" + ui.values[0] + ' - $' + ui.values[1]);
            console.log("slider");
            var str = "";
            var ct = $(".cl.active").attr("id");
            str = getSelectedCheckbox();
            GetData(str,minPrice, maxPrice,ct);

        }
    });

    function GetData(id, minimumPrice, maximumPrice,catid,clid) {
        $.ajax({
            url: '@Url.Action("FilterProducts", "Shop")',
            data: {
                id:id,
                minimumPrice: minimumPrice,
                maximumPrice: maximumPrice,
                catid: catid,
                clid:clid,
            }, contentType: "application/json; charset=utf-8",
            dataType: "json",
        })
            .done(function (response) {
                $(".productsDiv").html("");
                $(".productsDiv").html(response.offerHtml);
        })
        .fail(function (XMLHttpRequest, textStatus, errorThrown) {
            alert("FAIL");
        });
    }

    $('.cl ').click(function () {
        var ct = '';
        debugger;
        $(this).parent().find(".cl").removeClass("active");
        str = getSelectedCheckbox();

        ct = $(this).attr("id");
        $(this).addClass("active");
        
        
        console.log(ct);
        GetData(str,slidMin, slidMax,ct);
    });
     

    $(".clr").click(function () {
        var col = '';
        col = $(this).attr("id");
        str = getSelectedCheckbox();
        var ct = $(".cl.active").attr("id");
        console.log(col);
        GetData(str, slidMin, slidMax, ct,col);
    })



    $(document).ready(function () {
        $('.category ').click(function (e) {
            var catid = '';
            str = getSelectedCheckbox();

            console.log($(this).val);
        });
    });


    function sorting(selectObject) {

        var value = selectObject.value;
        console.log(value);
        str = str + $(this).attr("id") + ",";
        GetData()
    }



</script>

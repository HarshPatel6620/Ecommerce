@model IEnumerable<Ecommerce.Models.cart>
<style>
    .clearcart {
        margin-left: 90%;
        font-size: 25px;
        color: darkred;
    }
</style>
@*@if (TempData["cart"] as List<Ecommerce.Models.cart> != null)
    {*@
<div class="cart-table-area section-padding-100">
    <div class="container-fluid">
        @if (TempData["cart"] as List<Ecommerce.Models.cart> != null)
        {
            <div class="row">
                <div class="col-12 col-lg-8">
                    <div class="cart-title mt-50">
                        <h2>Shopping Cart</h2>
                    </div>
                    <a href="@Url.Action("clearcart", "Shop")" class="clearcart">ClearCart</a>

                    <div class="cart-table clearfix">
                        <table class="table table-responsive">
                            <thead>
                                <tr style="width:80%;">
                                    <th></th>
                                    <th>Name</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th style="background-color:ghostwhite;">remove</th>
                                </tr>
                            </thead>
                            <tbody style="width:80%">

                                @foreach (var item in TempData["cart"] as List<Ecommerce.Models.cart>)
                                {

                                    <tr>
                                        <td class="cart_product_img">
                                            <a href="#"><img src="@Url.Content(item.Image)" alt="Product"></a>
                                        </td>

                                        <td class="cart_product_desc">
                                            <h5>@item.Name</h5>
                                        </td>
                                        <td class="price">
                                            <span>@item.Price</span>
                                        </td>
                                        <td class="qty">

                                            <div class="qty-btn d-flex">


                                                <div class="">
                                                    @*<button type="button" id="plus"> + </button>
                                                        <input value="@item.Qty" min="1" max="5" type="number" step="1" name="quantity" id="quantity">
                                                        <a href="@Url.Action("Checkout","Shop",new {id= item.id })"> <button type="button" id="minus"> - </button></a>*@
                                                    <a href="@Url.Action("minus", "Shop", new { id = @item.id })"><span class="ion-ios-close">➖</span></a>
                                                    @item.Qty
                                                   @* <input type="" class="qty-text" id="qty3" step="1" min="1" max="300" name="quantity" value="@item.Qty">*@
                                                    <a href="@Url.Action("plus", "Shop", new { id = @item.id })"><span class="ion-ios-close">➕</span></a>
                                                </div>


                                            </div>

                                        </td>
                                        <td>
                                            <a href="@Url.Action("remove", "Shop", new { id = item.id })"><span class="ion-ios-close">❌</span></a>
                                        </td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="col-12 col-lg-4">
                    <div class="cart-summary">
                        <h5>Cart Total</h5>
                        <ul class="summary-table">
                            <li><span>subtotal:</span> <span name="total">@TempData["total"]</span></li>
                            <li><span>delivery:</span> <span>Free</span></li>
                            <li><span>total:</span> <span>@TempData["total"]</span></li>
                        </ul>
                        @using (Html.BeginForm("Checkouts", "Shop", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()


                            <div class="cart-btn mt-100">
                                <div class="payment-method">
                                    <!-- Cash on delivery -->
                                    <div class="custom-control custom-checkbox mr-sm-2">
                                      
                                            <input type="radio" name="payment" value="0">

                                            <label >Cash on Delivery</label>
                                     
                                    </div>
                                    <!-- Paypal -->
                                    <div class="custom-control custom-checkbox mr-sm-2">
                                        <input type="radio" name="payment" value="1">
                                        <label >Paypal <img class="ml-15" src="img/core-img/paypal.png" alt=""></label>
                                    </div>
                                </div>

                                <a href="@Url.Action("Addresss", "Shop")" class="btn amado-btn w-100">Checkout</a>
                            </div>
                            <button type="submit">Checkout</button>
                        }
                    </div>
                </div>


            </div>

        }
        else
        {
            <h2>Your Cart is Empty</h2>
            <img src="~/Content/upload/empty.jpg" />


            <button class="btn btn-secondary">
                <a href="@Url.Action("Shop","Shop")"> ShopNow</a>
            </button>
        }

       

    </div>
</div>
@*}
    else
    {
        <img src="~/Content/upload/empty.jpg" />
    }
*@

<script>
    const button = document.querySelector('#add-to-cart')
    const quantity = document.querySelector('#quantity')
    quantity.addEventListener('change', () => {
        // Sets the default quantity when adding the item
        button.setAttribute('data-item-quantity', quantity.value)
    })
    const select = document.querySelector('#color')
    select.addEventListener('change', () => {
        // Sets the default frame color when adding the item
        button.setAttribute("data-item-custom1-value", select.value)
    })

    const plus = document.querySelector('#plus')
    const minus = document.querySelector('#minus')

    plus.addEventListener('click', () => {
        const newQuantity = (quantity.value || 0) + 1
        quantity.value = newQuantity
    })

    minus.addEventListener('click', () => {
        const newQuantity = (quantity.value || 0) - 1
        quantity.value = newQuantity
    })
</script>



